{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/IlyaAndreev05/audio-matrix/schemas/config.schema.json",
  "title": "Audio Matrix configuration",
  "type": "object",
  "required": ["schema_version", "app", "active_profile", "ui", "mixer", "quick_settings", "engine", "devices", "applications", "buses", "routes", "dsp", "profiles", "calibrations"],
  "properties": {
    "schema_version": {"const": 4},
    "app": {"const": "audio-matrix"},
    "active_profile": {"type": "string", "minLength": 1},
    "ui": {"$ref": "#/$defs/ui"},
    "mixer": {"$ref": "#/$defs/mixer"},
    "quick_settings": {"type": "object", "required": ["groups"], "properties": {"enabled": {"type": "boolean"}, "show_output": {"type": "boolean"}, "show_mode": {"type": "boolean"}, "show_mute": {"type": "boolean"}, "groups": {"type": "array", "items": {"type": "object", "required": ["id", "name", "order", "collapsed"], "properties": {"id": {"type": "string", "minLength": 1}, "name": {"type": "string", "minLength": 1}, "order": {"type": "integer", "minimum": 0}, "collapsed": {"type": "boolean"}}, "additionalProperties": false}}}, "additionalProperties": true},
    "engine": {"type": "object", "properties": {"backend": {"const": "pipewire"}, "device_loss_policy": {"enum": ["mute", "pause", "fallback"]}, "transition_ms": {"type": "integer", "minimum": 0, "maximum": 1000}}, "additionalProperties": true},
    "devices": {"type": "array", "items": {"$ref": "#/$defs/device"}},
    "applications": {"type": "array", "items": {"$ref": "#/$defs/application"}},
    "buses": {"type": "array", "items": {"$ref": "#/$defs/bus"}},
    "routes": {"type": "array", "items": {"$ref": "#/$defs/route"}},
    "dsp": {"type": "object", "properties": {"order": {"type": "array", "items": {"type": "string"}}, "global_eq": {"$ref": "#/$defs/eq"}, "devices": {"type": "object", "additionalProperties": {"$ref": "#/$defs/eq"}}, "route_chains": {"type": "object", "additionalProperties": {"$ref": "#/$defs/eq"}}, "limiter": {"type": "object", "required": ["enabled", "ceiling_db", "lookahead_ms", "release_ms"], "properties": {"enabled": {"type": "boolean"}, "ceiling_db": {"type": "number", "minimum": -12, "maximum": 0}, "lookahead_ms": {"type": "number", "minimum": 1, "maximum": 10}, "release_ms": {"type": "number", "minimum": 5, "maximum": 500}}, "additionalProperties": false}}, "additionalProperties": true},
    "profiles": {"type": "array", "items": {"$ref": "#/$defs/profile"}},
    "calibrations": {"type": "array", "items": {"$ref": "#/$defs/calibration"}},
    "active_route": {"type": "string"},
    "route_groups": {"type": "array", "items": {"type": "object", "required": ["id", "name", "profile_id"], "properties": {"id": {"type": "string"}, "name": {"type": "string", "minLength": 1}, "profile_id": {"type": "string", "minLength": 1}}, "additionalProperties": false}},
    "route_library": {"type": "array", "items": {"type": "object", "required": ["id", "name", "profile_id", "nodes", "connections"], "properties": {"id": {"type": "string"}, "name": {"type": "string", "minLength": 1}, "profile_id": {"type": "string", "minLength": 1}, "group_id": {"type": "string"}, "nodes": {"type": "array", "items": {"type": "object"}}, "connections": {"type": "array", "items": {"type": "object"}}}, "additionalProperties": true}},
    "saved_copies": {"type": "array", "items": {"type": "object", "required": ["id", "name", "route", "active"], "properties": {"id": {"type": "string"}, "name": {"type": "string"}, "route": {"type": "object"}, "active": {"const": false}, "ui_layout": {"type": "object"}, "ui_scale": {"type": "number", "minimum": 0.5, "maximum": 2}}, "additionalProperties": false}},
    "graph_ui_layout": {"type": "object", "additionalProperties": {"type": "object", "additionalProperties": {"type": "object", "properties": {"x": {"type": "number", "minimum": 0, "maximum": 10000}, "y": {"type": "number", "minimum": 0, "maximum": 10000}}, "required": ["x", "y"], "additionalProperties": false}}},
    "graph_ui_scale": {"type": "object", "additionalProperties": {"type": "number", "minimum": 0.5, "maximum": 2}},
    "quick_controls": {"type": "array", "items": {"type": "object", "required": ["id", "node_id", "parameter_id", "group_id"], "properties": {"id": {"type": "string"}, "route_id": {"type": "string"}, "node_id": {"type": "string"}, "parameter_id": {"type": "string"}, "label": {"type": "string"}, "section": {"type": "string"}, "group_id": {"type": "string"}, "order": {"type": "integer"}}, "additionalProperties": false}},
    "export": {"type": "object", "additionalProperties": true}
  },
  "$defs": {
    "volume": {"type": "number", "minimum": 0, "maximum": 1},
    "ui": {"type": "object", "required": ["language", "theme"], "properties": {"language": {"enum": ["ru", "en"]}, "theme": {"enum": ["light", "dark", "system"]}, "start_minimized": {"type": "boolean"}}, "additionalProperties": true},
    "mixer": {"type": "object", "required": ["global_volume", "global_mute"], "properties": {"global_volume": {"$ref": "#/$defs/volume"}, "global_mute": {"type": "boolean"}, "global_eq": {"$ref": "#/$defs/eq"}}, "additionalProperties": true},
    "eq": {"type": "object", "required": ["enabled", "filters"], "properties": {"enabled": {"type": "boolean"}, "filters": {"type": "array", "items": {"$ref": "#/$defs/filter"}}}, "additionalProperties": true},
    "filter": {"type": "object", "required": ["type", "frequency_hz"], "properties": {"type": {"enum": ["peaking", "notch", "low_shelf", "high_shelf", "high_pass", "low_pass", "band_pass"]}, "frequency_hz": {"type": "number", "exclusiveMinimum": 0, "maximum": 96000}, "gain_db": {"type": "number", "minimum": -24, "maximum": 24}, "q": {"type": "number", "description": "For high_pass and low_pass, Q is editable at 12 dB/oct; other supported slopes use fixed Butterworth sections.", "exclusiveMinimum": 0, "maximum": 20}, "slope_db_oct": {"type": "number", "description": "High-pass/low-pass slope. Defaults to 12 dB/oct; supported: 6, 12, 18, 24, 36, 48.", "default": 12, "enum": [6, 12, 18, 24, 36, 48]}, "enabled": {"type": "boolean"}, "channels": {"type": "array", "items": {"enum": ["FL", "FR", "MONO"]}, "minItems": 1}}, "additionalProperties": true},
    "device": {"type": "object", "required": ["id", "selector", "volume", "mute"], "properties": {"id": {"type": "string"}, "name": {"type": "string", "minLength": 1}, "selector": {"type": "object", "required": ["kind", "value"], "properties": {"kind": {"enum": ["name_equals", "name_contains", "description_contains"]}, "value": {"type": "string"}}, "additionalProperties": false}, "role": {"enum": ["output", "source", "input", "speaker", "speakers", "subwoofer", "haptic_output", "microphone", "accelerometer"]}, "volume": {"$ref": "#/$defs/volume"}, "mute": {"type": "boolean"}, "filters_ref": {"type": "string", "pattern": "^dsp\\.route_chains\\..+$"}, "channel_map": {"type": "array", "items": {"type": "string"}}, "preferred_sample_rate": {"type": "integer", "minimum": 8000, "maximum": 384000}, "fallback": {"type": "string"}}, "additionalProperties": true},
    "application": {"type": "object", "required": ["id", "match", "volume", "mute"], "properties": {"id": {"type": "string"}, "match": {"type": "object", "properties": {"process": {"type": "string"}, "app_id": {"type": "string"}}, "additionalProperties": true}, "volume": {"$ref": "#/$defs/volume"}, "mute": {"type": "boolean"}, "bus": {"type": "string"}, "preferred_output": {"type": "string"}, "filters_ref": {"type": "string", "pattern": "^dsp\\.route_chains\\..+$"}}, "additionalProperties": true},
    "bus": {"type": "object", "required": ["id", "channels", "volume", "mute"], "properties": {"id": {"type": "string"}, "name": {"type": "string", "minLength": 1}, "role": {"enum": ["general", "music", "effects", "subwoofer"]}, "channels": {"enum": ["mono", "stereo", "5.1", "7.1"]}, "volume": {"$ref": "#/$defs/volume"}, "mute": {"type": "boolean"}, "filters_ref": {"type": "string", "pattern": "^dsp\\.route_chains\\..+$"}}, "additionalProperties": true},
    "route": {"type": "object", "required": ["id", "from", "to", "enabled"], "properties": {"id": {"type": "string"}, "name": {"type": "string", "minLength": 1}, "from": {"type": "string"}, "to": {"type": "string"}, "gain_db": {"type": "number", "minimum": -60, "maximum": 24}, "volume": {"$ref": "#/$defs/volume"}, "mute": {"type": "boolean"}, "delay_ms": {"type": "number", "minimum": 0, "maximum": 2000}, "channel_map": {"enum": ["stereo", "mono", "mono_sum", "left", "right", "swap_lr", "center", "lfe", "rear_left", "rear_right", "rear_sum", "side_left", "side_right", "side_sum", "surround_sum", "all_sum"]}, "channel_matrix": {"type": "object", "required": ["inputs", "outputs", "coefficients"], "properties": {"inputs": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"enum": ["MONO", "FL", "FR", "FC", "LFE", "RL", "RR", "RC", "SL", "SR"]}}, "outputs": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"enum": ["MONO", "FL", "FR", "FC", "LFE", "RL", "RR", "RC", "SL", "SR"]}}, "coefficients": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"type": "number", "minimum": -1, "maximum": 1}}}}, "additionalProperties": false}, "polarity": {"enum": ["normal", "invert", "invert_left", "invert_right"]}, "fallback": {"type": "string"}, "filters_ref": {"type": "string", "pattern": "^dsp\\.route_chains\\..+$"}, "priority": {"type": "integer", "minimum": 0, "maximum": 1000}, "enabled": {"type": "boolean"}}, "additionalProperties": true},
    "profile": {"type": "object", "required": ["id", "name", "mode", "default_output", "selected_route_id"], "properties": {"id": {"type": "string"}, "name": {"type": "string"}, "mode": {"enum": ["haptic", "subwoofer", "speaker", "hybrid", "multi-output", "off"]}, "default_output": {"type": "string"}, "selected_route_id": {"type": "string"}, "active_buses": {"type": "array", "items": {"type": "string"}}, "active_routes": {"type": "array", "items": {"type": "string"}}, "device_overrides": {"type": "object"}}, "additionalProperties": true},
    "calibration": {"type": "object", "required": ["id", "method", "verified"], "properties": {"id": {"type": "string"}, "device": {"type": ["string", "null"]}, "channel": {"type": ["string", "null"]}, "method": {"enum": ["manual", "microphone", "accelerometer", "combined"]}, "measurement_kind": {"enum": ["impulse_decay", null]}, "sensor_source": {"type": ["string", "null"]}, "sensor_source_description": {"type": ["string", "null"]}, "sensor_mount": {"type": ["string", "null"]}, "measurement_file": {"type": ["string", "null"]}, "response_curve_file": {"type": ["string", "null"]}, "decay_curve_file": {"type": ["string", "null"]}, "filters_ref": {"type": ["string", "null"]}, "rollback_filters_ref": {"type": ["string", "null"], "pattern": "^dsp\\.route_chains\\..+$"}, "verified": {"type": "boolean"}, "sample_rate_hz": {"type": "integer", "minimum": 8000, "maximum": 192000}, "sensor_channel_index": {"type": "integer", "minimum": 0, "maximum": 1}, "impulse_offset_ms": {"type": "integer", "minimum": 20, "maximum": 60000}, "response_window_ms": {"type": "integer", "minimum": 200, "maximum": 10000}, "impulse_peak_offset_ms": {"type": "integer", "minimum": 0, "maximum": 60000}, "peak_pcm": {"type": "number", "minimum": 0, "maximum": 1}, "noise_rms_pcm": {"type": "number", "minimum": 0, "maximum": 1}, "clipped": {"type": "boolean"}, "dominant_frequency_hz": {"type": ["number", "null"], "minimum": 20, "maximum": 1000}, "quality_factor": {"type": ["number", "null"], "exclusiveMinimum": 0, "maximum": 1000000}, "decay_t20_ms": {"type": ["number", "null"], "exclusiveMinimum": 0, "maximum": 600000}, "decay_t60_projected_ms": {"type": ["number", "null"], "exclusiveMinimum": 0, "maximum": 600000}, "analyzed_at": {"type": "string"}, "notes": {"type": "string"}}, "additionalProperties": true}
  },
  "additionalProperties": false
}
