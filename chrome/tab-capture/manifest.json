{
  "manifest_version": 3,
  "name": "Audio Matrix · захват звука вкладок Chrome",
  "version": "1.0.0",
  "description": "Передаёт звук выбранной пользователем вкладки Chrome в Audio Matrix.",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": ["activeTab", "tabs", "tabCapture", "offscreen", "storage", "nativeMessaging"],
  "background": { "service_worker": "service-worker.js" },
  "action": { "default_popup": "popup.html", "default_title": "Audio Matrix · захват звука вкладок Chrome" }
}
